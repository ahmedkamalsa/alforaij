# ══════════════════════════════════════════════════════════════════
# Al-Furaj Research Assistant — Environment Variables
# ══════════════════════════════════════════════════════════════════
# Copy this to .env and fill in your values:
#   cp .env.example .env

# ── Server ──
ALFORAIJ_ASSISTANT_HOST=127.0.0.1
ALFORAIJ_ASSISTANT_PORT=8000
ALFORAIJ_LOG_LEVEL=INFO

# ── Supabase (database) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ── Google Sign-In ──
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── WhatsApp (Meta Cloud API) — optional ──
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_SENDER_NAME=فريق الفريج العقاري

# ══════════════════════════════════════════════════════════════════
# AI Router — Free AI Providers (Fallback Chain)
# ══════════════════════════════════════════════════════════════════
# The router tries providers in order: Ollama → Gemini → OpenRouter → AgentRouter
# Configure at least one to enable AI analysis and chat assistant.

# 1. Ollama (local, free, unlimited) — install from https://ollama.com
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# 2. Google AI Studio / Gemini (free 1M tokens/day)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
# Or: GOOGLE_AI_STUDIO_KEY=your-key

# 3. OpenRouter (free tier models)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# 4. AgentRouter (existing — optional fallback)
AGENT_ROUTER_API_KEY=your-agentrouter-key
AGENT_ROUTER_API_URL=https://api.agentrouter.org/v1/chat/completions

# ── Provider Order (optional) ──
# Default: ollama,gemini,openrouter,agentrouter
# AI_PROVIDER_ORDER=gemini,ollama,openrouter
